<resources>
    <!-- Base application theme -->
    <style name="Theme.SafePhrase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.SafePhrase.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#2E7D32</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SafePhrase</item>
    </style>
</resources>
